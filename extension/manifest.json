{
  "manifest_version": 3,
  "name": "LinguaPlay — Japanese AI Immersion Player",
  "version": "1.0.0",
  "description": "AI-enhanced Japanese language immersion player with interactive subtitles, Kuromoji grammar breakdown, Gemini AI tutor, and Anki sync.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinguaPlay — Japanese Immersion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "js/youtube-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/watch*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "lib/wanakana.min.js",
        "js/japanese-parser.js",
        "lib/yomitan-deinflector.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://lrclib.net/*",
    "http://lyrics.kugou.com/*",
    "http://*/*",
    "https://*/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.deepseek.com/*",
    "https://translate.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "lib/*",
        "css/*",
        "js/*",
        "player.html",
        "options.html",
        "options.css",
        "options.js",
        "popup.html",
        "popup.css",
        "popup.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
